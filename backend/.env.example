# Xcreener 2.0 - Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://xcreener:xcreener2025@localhost:5432/xcreener2
DATABASE_URL_SYNC=postgresql+psycopg2://xcreener:xcreener2025@localhost:5432/xcreener2

# JWT Auth
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Scheduler (Eastern Time)
DAILY_SCAN_HOUR=18
DAILY_SCAN_MINUTE=0
WEEKLY_SCAN_DAY=fri
MONTHLY_SCAN_DAY=last

# Data Fetcher
FETCH_BATCH_SIZE=50
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_RETRIES=2
HISTORICAL_PERIOD=2y

# App
APP_NAME=Xcreener 2.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
