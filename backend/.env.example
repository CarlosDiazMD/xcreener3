# Xcreener 2.0 - Environment Configuration
# Copy this file to .env and fill in the values

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Replace with your Neon connection string. Add ?sslmode=require for Neon.
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── JWT Auth ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ─── Scheduler (Eastern Time) ───────────────────────────────────────────────
DAILY_SCAN_HOUR=18
DAILY_SCAN_MINUTE=0
WEEKLY_SCAN_DAY=fri
MONTHLY_SCAN_DAY=last

# ─── Data Fetcher ───────────────────────────────────────────────────────────
FETCH_BATCH_SIZE=50
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_RETRIES=2
HISTORICAL_PERIOD=2y

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Xcreener 2.0
DEBUG=true
# Add your Vercel deployment URL here (e.g., https://xcreener3.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
